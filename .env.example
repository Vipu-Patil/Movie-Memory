# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=""

# Optional: a separate, disposable database for the integration tests.
# When unset, those tests are skipped and only the unit tests run.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory_test"
